#!/usr/bin/env bash
# 把一张图片发到 Lark 聊天（容器版）。
#
# 用法: larkimg <图片路径> [chat_id]
#
# 和宿主机版（~/.local/bin/larkimg）的两点差异：
#
#   1. chat_id 从 $LARK_CHAT_ID 拿（claude-exec.sh 注入）。宿主机版是反查
#      ~/.lark-agent/<slug>/sessions.json，那文件容器里看不到。
#      解析不出来就报错退出 —— **绝不猜**，猜错就是把图发进别人的群。
#   2. 用 jq 解析 JSON，不用 python3 —— 容器镜像里没装 python。
#
# 凭据取自 LARK_APP_ID / LARK_APP_SECRET（claude-exec.sh 注入）。
set -euo pipefail

IMG="${1:-}"
BASE="${LARK_API_BASE:-https://open.larksuite.com}"
CHAT="${2:-${LARK_CHAT_ID:-}}"

[ -n "$IMG" ] || { echo "用法: larkimg <图片路径> [chat_id]" >&2; exit 2; }
[ -f "$IMG" ] || { echo "找不到文件: $IMG" >&2; exit 1; }
[ -n "$CHAT" ] || {
  echo "没有 chat_id：环境变量 LARK_CHAT_ID 为空，也没传第二个参数。" >&2
  echo "不猜是故意的 —— 猜错会把图发进别人的会话。" >&2
  exit 1; }
[ -n "${LARK_APP_ID:-}" ] && [ -n "${LARK_APP_SECRET:-}" ] || {
  echo "缺少 LARK_APP_ID / LARK_APP_SECRET 环境变量" >&2; exit 1; }

# Lark 图片上限 10MB
SIZE=$(stat -c%s "$IMG")
[ "$SIZE" -le 10485760 ] || {
  echo "图片 $((SIZE/1024/1024))MB，超过 10MB 上限，先压缩" >&2; exit 1; }

api() { # api <json> <字段>  —— 有 code 就当错误报出来
  jq -er 'if (.code // 0) != 0 then ("API 错误: " + (.msg // "未知") | halt_error(1)) else . end' \
    | jq -er "$1"
}

TOKEN=$(curl -sS -X POST "$BASE/open-apis/auth/v3/tenant_access_token/internal" \
  -H 'Content-Type: application/json' \
  -d "{\"app_id\":\"$LARK_APP_ID\",\"app_secret\":\"$LARK_APP_SECRET\"}" \
  | api '.tenant_access_token')

KEY=$(curl -sS -X POST "$BASE/open-apis/im/v1/images" \
  -H "Authorization: Bearer $TOKEN" \
  -F "image_type=message" -F "image=@$IMG" \
  | api '.data.image_key')

curl -sS -X POST "$BASE/open-apis/im/v1/messages?receive_id_type=chat_id" \
  -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
  -d "$(jq -nc --arg c "$CHAT" --arg k "$KEY" \
        '{receive_id:$c, msg_type:"image", content:({image_key:$k}|tostring)}')" \
  | api '.data.message_id' >/dev/null

echo "已发送: $(basename "$IMG")"
